{
  "version": 2,
  "builds": [
    {"src": "api/index.py", "use": "@vercel/python"},
    {"src": "api/trade.py", "use": "@vercel/python"},
    {"src": "public/**", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/ask", "dest": "api/index.py"},
    {"src": "/api/trade", "dest": "api/trade.py"},
    {"src": "/", "dest": "public/index.html"}
  ]
}
